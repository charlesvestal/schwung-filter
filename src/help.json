{
  "title": "Filter",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Multi-mode state-",
        "variable filter with",
        "movement.",
        "",
        "Modes: LP HP BP",
        " Notch Peak AP",
        "",
        "Envelope follower",
        "+ tempo-synced LFO",
        "modulate cutoff.",
        "",
        "Cutoff is log +",
        "smoothed (no zipper)."
      ]
    },
    {
      "title": "Knobs (root)",
      "lines": [
        "1: Cutoff 0-100%",
        "   log 20Hz-20kHz",
        "2: Resonance",
        "3: Drive (pre-sat)",
        "4: Mix dry/wet",
        "5: Env Amount",
        "   (bipolar)",
        "6: LFO Amount",
        "7: LFO Division",
        "8: Mode"
      ]
    },
    {
      "title": "Envelope",
      "lines": [
        "Auto-wah: cutoff",
        "follows input level.",
        "",
        "Env Amt: depth,",
        " +opens / -closes",
        "Attack: 1-500ms",
        "Release: 1-500ms",
        "",
        "No MIDI needed -",
        "tracks the audio."
      ]
    },
    {
      "title": "LFO",
      "lines": [
        "Cyclic cutoff sweep.",
        "",
        "Amount: depth",
        "Shape: Sine Tri Saw",
        " Sqr S&H",
        "Sync: Free or Sync",
        "Division: 1/1..1/32",
        " (synced to clock)",
        "Rate Hz: when Free"
      ]
    },
    {
      "title": "Modes",
      "lines": [
        "LP: lowpass",
        "HP: highpass",
        "BP: bandpass",
        "Notch: cuts a band",
        "Peak: boosts (reso)",
        "AP: allpass (phase)"
      ]
    },
    {
      "title": "Models",
      "lines": [
        "SVF: clean TPT",
        " state-variable.",
        " Only model now.",
        "",
        "Planned: Moog, SEM,",
        " Prophet, Roland."
      ]
    }
  ]
}
